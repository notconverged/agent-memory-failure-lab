{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Competitor phase observation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "phase_id",
    "observer",
    "checks",
    "notes"
  ],
  "properties": {
    "phase_id": {
      "type": "string"
    },
    "observer": {
      "type": "string"
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "capture_completeness": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "structure_type_fidelity": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "lifecycle_correctness": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "provenance_traceability": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "fresh_session_retrieval": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "behavior_correctness": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "controllability": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "storage_location": {
      "type": [
        "string",
        "null"
      ]
    },
    "memory_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "string"
    }
  }
}
